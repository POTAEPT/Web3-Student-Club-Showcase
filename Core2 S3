void setupWebHandlers() {
    // --- [สำคัญ] iOS Handler - ตอบ 200 OK ทันที (แก้หมุนติ้ว) ---
    // Apple Devices จะเช็ค URL พวกนี้
    auto appleHandler = [](AsyncWebServerRequest *request){
        Serial.println("[Captive] iOS Probe Detected");
        AsyncWebServerResponse *response = request->beginResponse_P(200, "text/html", index_html);
        response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
        request->send(response);
    };
    
    server.on("/hotspot-detect.html", HTTP_GET, appleHandler);
    server.on("/hotspot-detect.html", HTTP_POST, appleHandler); // เผื่อบางรุ่นส่ง POST
    server.on("/success.html", HTTP_GET, appleHandler);

    // --- Android Handler ---
    auto androidHandler = [](AsyncWebServerRequest *request){
        request->send(200, "text/html", "<!DOCTYPE html><html><head><meta http-equiv='refresh' content='0;url=http://192.168.4.1/'></head><body>Redirecting...</body></html>");
    };
    server.on("/generate_204", HTTP_GET, androidHandler);
    server.on("/gen_204", HTTP_GET, androidHandler);
    server.on("/mobile/status.php", HTTP_GET, androidHandler);

    // --- Main Page ---
    server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
        AsyncWebServerResponse *response = request->beginResponse_P(200, "text/html", index_html);
        response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
        request->send(response);
    });

    // --- Form Submit ---
    server.on("/submit_identity", HTTP_POST, [](AsyncWebServerRequest *request){
        if (request->hasParam("username", true)) {
            String inputName = request->getParam("username", true)->value();
            participant.reset();
            participant.Username = inputName;
            shouldSyncUser = true; 
            drawUI();
            request->send_P(200, "text/html", success_html);
        } else {
            request->send(400, "text/plain", "Missing Username");
        }
    });

    // --- Reset ---
    server.on(ENDPOINT_RESET_GLOBAL, HTTP_POST, [](AsyncWebServerRequest *request){
        participant.reset();
        participant.Username = "";
        hasClientConnected = false;
        previousClientCount = 0;
        esp_wifi_deauth_sta(0); 
        drawUI();
        request->send(200, "application/json", "{\"status\":\"success\"}");
    });

    // --- [จุดแก้ปัญหาหมุนติ้ว] Catch-All (NotFound) ---
    // แทนที่จะ Redirect -> ให้ส่งหน้าเว็บกลับไปเลย (200 OK)
    // iOS จะได้ไม่ต้องวิ่งรอบสอง
    server.onNotFound([](AsyncWebServerRequest *request){
        AsyncWebServerResponse *response = request->beginResponse_P(200, "text/html", index_html);
        response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
        request->send(response);
    });
}

void setup() {
    M5.begin(true, false, true, true);
    Serial.begin(115200);
    
    // Watchdog
    esp_task_wdt_init(30, true);
    esp_task_wdt_add(NULL);

    WiFi.mode(WIFI_OFF);
    delay(100);
    
    WiFi.mode(WIFI_AP);
    WiFi.softAPConfig(IP_STATION1_AP, IP_STATION1_AP, NETMASK);
    WiFi.softAP(AP_SSID, AP_PASSWORD, 1, 0, 10);
    
    // Max Performance
    esp_wifi_set_ps(WIFI_PS_NONE);
    esp_wifi_set_bandwidth(WIFI_IF_AP, WIFI_BW_HT20);

    // DNS Server
    dnsServer.start(53, "*", IP_STATION1_AP);
    
    setupWebHandlers();
    server.begin();

    Serial.println("\n>>> SYSTEM READY (iOS Optimized) <<<");
    Serial.printf("AP: %s | IP: %s\n", AP_SSID, WiFi.softAPIP().toString().c_str());

    drawUI();
}

